# Required
CASHCTRL_ORGANISATION=myorg
CASHCTRL_APIKEY=

# Optional
CASHCTRL_LANG=de            # de | fr | it | en
CASHCTRL_MODE=read          # read | write  (write mode adds four write tools)
CASHCTRL_DOWNLOAD_DIR=      # where document tools will write files
CASHCTRL_ENABLE_SALARY=     # 1 to expose the salary module
